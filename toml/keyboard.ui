# Special keys
shift = {parent_binding = "keyboard", path="shift"}
numeric = {parent_binding = "keyboard", path="numeric"}
space = {parent_binding = "keyboard", path="space"}
clear = {parent_binding = "keyboard", path="clear"}
enter = {parent_binding = "keyboard", path="enter"}
alphabetic = {parent_binding = "keyboard", path="alphabetic"}
numpad = {parent_binding = "keyboard", path="numpad"}
symbols = {parent_binding = "keyboard", path="symbols"}
close = {parent_binding = "self", path="close_area"}
emoji = {parent_binding = "keyboard", path="emoji"}

# Suggestions
suggest_1 = {parent_binding = "background", path="suggest_1"}
suggest_2 = {parent_binding = "background", path="suggest_2"}
suggest_3 = {parent_binding = "background", path="suggest_3"}

[animations]

# General states
show = {parent_binding="self", path="", start="ani_in", end="ani_idle"}
hide = {parent_binding="self", path="", start="ani_out", end="ani_end", also_play=["suggest_0"]}
stop = {parent_binding="self", path="", end="ani_in", also_play=["suggest_0"]}

# Layouts
layout_qwerty = {binding="keyboard", end="qwerty"}
layout_numeric = {binding="keyboard", end="numeric"}
layout_symbols = {binding="keyboard", end="symbols"}
layout_numpad = {binding="keyboard", end="numpad"}

# Suggestions states
suggest_0 = {binding="background", end="suggest_0"}
suggest_1 = {binding="background", end="suggest_1"}
suggest_2 = {binding="background", end="suggest_2"}
suggest_3 = {binding="background", end="suggest_3"}

default_animation="stop"

[bindings]

# Base containers
self = "bottom"
keyboard = {parent_binding = "self", path="keyboard/layout"}
background = {parent_binding = "self", path="keyboard/bgr"}

# Generic keys bindings
k1 = {parent_binding = "keyboard", path="k1"}
