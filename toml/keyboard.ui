id = "ui_keyboard"
priority = 10

sc_file_source = "ClientFile"
sc_file = "sc/effects_brawler_stella.sc"
container_bottom = "keyboard"

interactive = [""]

[buttons]

# Generic keys
k1 = {parent_binding = "keyboard", path="k1"}
